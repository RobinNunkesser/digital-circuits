<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes/>
  <visualElements>
    <!-- Clock -->
    <visualElement>
      <elementName>Clock</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>C</string></entry>
      </elementAttributes>
      <pos x="100" y="80"/>
    </visualElement>

    <!-- Flipflops (pos x=200): D at y, C at y+20; Q at x+60, y -->
    <visualElement>
      <elementName>D_FF</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>FF_0</string></entry>
      </elementAttributes>
      <pos x="200" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>D_FF</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>FF_1</string></entry>
      </elementAttributes>
      <pos x="200" y="240"/>
    </visualElement>
    <visualElement>
      <elementName>D_FF</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>FF_2</string></entry>
      </elementAttributes>
      <pos x="200" y="340"/>
    </visualElement>

    <!-- Combinational Logic on the right -->
    <!-- NOT for a0 -->
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="340" y="140"/>
    </visualElement>

    <!-- XOR for a1 -->
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="380" y="220"/>
    </visualElement>

    <!-- AND for a2 -->
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="340" y="300"/>
    </visualElement>

    <!-- XOR for a2 -->
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="420" y="340"/>
    </visualElement>

    <!-- Outputs a0, a1, a2 -->
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_0</string></entry>
      </elementAttributes>
      <pos x="520" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_1</string></entry>
      </elementAttributes>
      <pos x="520" y="240"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_2</string></entry>
      </elementAttributes>
      <pos x="520" y="360"/>
    </visualElement>
  </visualElements>
  <wires>
    <!-- Clock distribution -->
    <wire><p1 x="100" y="80"/><p2 x="160" y="80"/></wire>
    <wire><p1 x="160" y="80"/><p2 x="160" y="160"/></wire>
    <wire><p1 x="160" y="160"/><p2 x="200" y="160"/></wire>
    <wire><p1 x="160" y="160"/><p2 x="160" y="260"/></wire>
    <wire><p1 x="160" y="260"/><p2 x="200" y="260"/></wire>
    <wire><p1 x="160" y="260"/><p2 x="160" y="360"/></wire>
    <wire><p1 x="160" y="360"/><p2 x="200" y="360"/></wire>

    <!-- Q0 (from 260,140) to Not, and branching to logic and output -->
    <wire><p1 x="260" y="140"/><p2 x="290" y="140"/></wire>
    <wire><p1 x="290" y="140"/><p2 x="340" y="140"/></wire>
    <wire><p1 x="290" y="140"/><p2 x="290" y="220"/></wire>
    <wire><p1 x="290" y="220"/><p2 x="380" y="220"/></wire>
    <wire><p1 x="290" y="220"/><p2 x="290" y="300"/></wire>
    <wire><p1 x="290" y="300"/><p2 x="340" y="300"/></wire>

    <!-- Q1 (from 260,240) to logic -->
    <wire><p1 x="260" y="240"/><p2 x="310" y="240"/></wire>
    <wire><p1 x="310" y="240"/><p2 x="310" y="260"/></wire>
    <wire><p1 x="310" y="260"/><p2 x="380" y="260"/></wire>
    <wire><p1 x="310" y="260"/><p2 x="310" y="340"/></wire>
    <wire><p1 x="310" y="340"/><p2 x="340" y="340"/></wire>

    <!-- Q2 (from 260,340) to logic -->
    <wire><p1 x="260" y="340"/><p2 x="320" y="340"/></wire>
    <wire><p1 x="320" y="340"/><p2 x="320" y="380"/></wire>
    <wire><p1 x="320" y="380"/><p2 x="420" y="380"/></wire>

    <!-- AND(Q1, Q0) to XOR -->
    <wire><p1 x="400" y="320"/><p2 x="410" y="320"/></wire>
    <wire><p1 x="410" y="320"/><p2 x="410" y="340"/></wire>
    <wire><p1 x="410" y="340"/><p2 x="420" y="340"/></wire>

    <!-- Outputs and feedback to D inputs -->
    <!-- Bit 0: Not output (380,140) -> a0 (520,140) and feedback to D0 (200,140) -->
    <wire><p1 x="380" y="140"/><p2 x="470" y="140"/></wire>
    <wire><p1 x="470" y="140"/><p2 x="520" y="140"/></wire>
    <wire><p1 x="470" y="140"/><p2 x="470" y="110"/></wire>
    <wire><p1 x="470" y="110"/><p2 x="140" y="110"/></wire>
    <wire><p1 x="140" y="110"/><p2 x="140" y="140"/></wire>
    <wire><p1 x="140" y="140"/><p2 x="200" y="140"/></wire>

    <!-- Bit 1: XOR output (440,240) -> a1 (520,240) and feedback to D1 (200,240) -->
    <wire><p1 x="440" y="240"/><p2 x="480" y="240"/></wire>
    <wire><p1 x="480" y="240"/><p2 x="520" y="240"/></wire>
    <wire><p1 x="480" y="240"/><p2 x="480" y="200"/></wire>
    <wire><p1 x="480" y="200"/><p2 x="130" y="200"/></wire>
    <wire><p1 x="130" y="200"/><p2 x="130" y="240"/></wire>
    <wire><p1 x="130" y="240"/><p2 x="200" y="240"/></wire>

    <!-- Bit 2: XOR output (480,360) -> a2 (520,360) and feedback to D2 (200,340) -->
    <wire><p1 x="480" y="360"/><p2 x="490" y="360"/></wire>
    <wire><p1 x="490" y="360"/><p2 x="520" y="360"/></wire>
    <wire><p1 x="490" y="360"/><p2 x="490" y="420"/></wire>
    <wire><p1 x="490" y="420"/><p2 x="120" y="420"/></wire>
    <wire><p1 x="120" y="420"/><p2 x="120" y="340"/></wire>
    <wire><p1 x="120" y="340"/><p2 x="200" y="340"/></wire>
  </wires>
</circuit>
