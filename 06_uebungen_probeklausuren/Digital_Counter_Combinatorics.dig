<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes/>
  <visualElements>
    <!-- Inputs -->
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>e_0</string></entry>
      </elementAttributes>
      <pos x="140" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>e_1</string></entry>
      </elementAttributes>
      <pos x="140" y="240"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>e_2</string></entry>
      </elementAttributes>
      <pos x="140" y="360"/>
    </visualElement>

    <!-- a0 = NOT(e0) -->
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="240" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_0</string></entry>
      </elementAttributes>
      <pos x="460" y="140"/>
    </visualElement>

    <!-- a1 = e1 XOR e0 -->
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="320" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_1</string></entry>
      </elementAttributes>
      <pos x="460" y="240"/>
    </visualElement>

    <!-- AND(e1, e0) -->
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="240" y="300"/>
    </visualElement>

    <!-- a2 = e2 XOR AND(e1, e0) -->
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="340" y="340"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>a_2</string></entry>
      </elementAttributes>
      <pos x="460" y="360"/>
    </visualElement>
  </visualElements>
  <wires>
    <!-- e0 connections -->
    <wire><p1 x="140" y="140"/><p2 x="180" y="140"/></wire>
    <wire><p1 x="180" y="140"/><p2 x="240" y="140"/></wire>
    <wire><p1 x="180" y="140"/><p2 x="180" y="220"/></wire>
    <wire><p1 x="180" y="220"/><p2 x="320" y="220"/></wire>
    <wire><p1 x="180" y="220"/><p2 x="180" y="300"/></wire>
    <wire><p1 x="180" y="300"/><p2 x="240" y="300"/></wire>
    <wire><p1 x="280" y="140"/><p2 x="460" y="140"/></wire>

    <!-- e1 connections -->
    <wire><p1 x="140" y="240"/><p2 x="200" y="240"/></wire>
    <wire><p1 x="200" y="240"/><p2 x="200" y="260"/></wire>
    <wire><p1 x="200" y="260"/><p2 x="320" y="260"/></wire>
    <wire><p1 x="200" y="260"/><p2 x="200" y="340"/></wire>
    <wire><p1 x="200" y="340"/><p2 x="240" y="340"/></wire>

    <!-- a1 out -->
    <wire><p1 x="380" y="240"/><p2 x="460" y="240"/></wire>

    <!-- AND(e1, e0) to XOR -->
    <wire><p1 x="300" y="320"/><p2 x="320" y="320"/></wire>
    <wire><p1 x="320" y="320"/><p2 x="320" y="340"/></wire>
    <wire><p1 x="320" y="340"/><p2 x="340" y="340"/></wire>

    <!-- e2 to XOR -->
    <wire><p1 x="140" y="360"/><p2 x="220" y="360"/></wire>
    <wire><p1 x="220" y="360"/><p2 x="220" y="380"/></wire>
    <wire><p1 x="220" y="380"/><p2 x="340" y="380"/></wire>

    <!-- a2 out -->
    <wire><p1 x="400" y="360"/><p2 x="460" y="360"/></wire>
  </wires>
</circuit>
