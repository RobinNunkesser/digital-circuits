<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes/>
  <visualElements>
    <!-- Inputs D0..D3 -->
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>D_0</string></entry></elementAttributes><pos x="160" y="100"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>D_1</string></entry></elementAttributes><pos x="160" y="200"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>D_2</string></entry></elementAttributes><pos x="160" y="300"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>D_3</string></entry></elementAttributes><pos x="160" y="400"/></visualElement>

    <!-- Clock and Enable -->
    <visualElement><elementName>Clock</elementName><elementAttributes><entry><string>Label</string><string>C</string></entry></elementAttributes><pos x="160" y="480"/></visualElement>
    <visualElement><elementName>In</elementName><elementAttributes><entry><string>Label</string><string>EN</string></entry></elementAttributes><pos x="160" y="540"/></visualElement>

    <!-- 4 D-FFs -->
    <visualElement><elementName>Multiplexer</elementName><elementAttributes/><pos x="260" y="80"/></visualElement>
    <visualElement><elementName>D_FF</elementName><elementAttributes><entry><string>Label</string><string>FF_0</string></entry></elementAttributes><pos x="340" y="100"/></visualElement>

    <visualElement><elementName>Multiplexer</elementName><elementAttributes/><pos x="260" y="180"/></visualElement>
    <visualElement><elementName>D_FF</elementName><elementAttributes><entry><string>Label</string><string>FF_1</string></entry></elementAttributes><pos x="340" y="200"/></visualElement>

    <visualElement><elementName>Multiplexer</elementName><elementAttributes/><pos x="260" y="280"/></visualElement>
    <visualElement><elementName>D_FF</elementName><elementAttributes><entry><string>Label</string><string>FF_2</string></entry></elementAttributes><pos x="340" y="300"/></visualElement>

    <visualElement><elementName>Multiplexer</elementName><elementAttributes/><pos x="260" y="380"/></visualElement>
    <visualElement><elementName>D_FF</elementName><elementAttributes><entry><string>Label</string><string>FF_3</string></entry></elementAttributes><pos x="340" y="400"/></visualElement>

    <!-- Outputs Q0..Q3 -->
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>Q_0</string></entry></elementAttributes><pos x="480" y="100"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>Q_1</string></entry></elementAttributes><pos x="480" y="200"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>Q_2</string></entry></elementAttributes><pos x="480" y="300"/></visualElement>
    <visualElement><elementName>Out</elementName><elementAttributes><entry><string>Label</string><string>Q_3</string></entry></elementAttributes><pos x="480" y="400"/></visualElement>
  </visualElements>
  <wires>
    <!-- Bit 0 -->
    <wire><p1 x="160" y="100"/><p2 x="260" y="120"/></wire>
    <wire><p1 x="300" y="100"/><p2 x="340" y="100"/></wire>
    <wire><p1 x="400" y="100"/><p2 x="440" y="100"/></wire>
    <wire><p1 x="440" y="100"/><p2 x="480" y="100"/></wire>
    <wire><p1 x="240" y="60"/><p2 x="440" y="60"/></wire>
    <wire><p1 x="240" y="60"/><p2 x="240" y="80"/></wire>
    <wire><p1 x="240" y="80"/><p2 x="260" y="80"/></wire>
    <wire><p1 x="440" y="60"/><p2 x="440" y="100"/></wire>

    <!-- Bit 1 -->
    <wire><p1 x="160" y="200"/><p2 x="260" y="220"/></wire>
    <wire><p1 x="300" y="200"/><p2 x="340" y="200"/></wire>
    <wire><p1 x="400" y="200"/><p2 x="440" y="200"/></wire>
    <wire><p1 x="440" y="200"/><p2 x="480" y="200"/></wire>
    <wire><p1 x="240" y="160"/><p2 x="440" y="160"/></wire>
    <wire><p1 x="240" y="160"/><p2 x="240" y="180"/></wire>
    <wire><p1 x="240" y="180"/><p2 x="260" y="180"/></wire>
    <wire><p1 x="440" y="160"/><p2 x="440" y="200"/></wire>

    <!-- Bit 2 -->
    <wire><p1 x="160" y="300"/><p2 x="260" y="320"/></wire>
    <wire><p1 x="300" y="300"/><p2 x="340" y="300"/></wire>
    <wire><p1 x="400" y="300"/><p2 x="440" y="300"/></wire>
    <wire><p1 x="440" y="300"/><p2 x="480" y="300"/></wire>
    <wire><p1 x="240" y="260"/><p2 x="440" y="260"/></wire>
    <wire><p1 x="240" y="260"/><p2 x="240" y="280"/></wire>
    <wire><p1 x="240" y="280"/><p2 x="260" y="280"/></wire>
    <wire><p1 x="440" y="260"/><p2 x="440" y="300"/></wire>

    <!-- Bit 3 -->
    <wire><p1 x="160" y="400"/><p2 x="260" y="420"/></wire>
    <wire><p1 x="300" y="400"/><p2 x="340" y="400"/></wire>
    <wire><p1 x="400" y="400"/><p2 x="440" y="400"/></wire>
    <wire><p1 x="440" y="400"/><p2 x="480" y="400"/></wire>
    <wire><p1 x="240" y="360"/><p2 x="440" y="360"/></wire>
    <wire><p1 x="240" y="360"/><p2 x="240" y="380"/></wire>
    <wire><p1 x="240" y="380"/><p2 x="260" y="380"/></wire>
    <wire><p1 x="440" y="360"/><p2 x="440" y="400"/></wire>

    <!-- Clock bus -->
    <wire><p1 x="160" y="480"/><p2 x="320" y="480"/></wire>
    <wire><p1 x="320" y="120"/><p2 x="340" y="120"/></wire>
    <wire><p1 x="320" y="220"/><p2 x="340" y="220"/></wire>
    <wire><p1 x="320" y="320"/><p2 x="340" y="320"/></wire>
    <wire><p1 x="320" y="420"/><p2 x="340" y="420"/></wire>
    <wire><p1 x="320" y="120"/><p2 x="320" y="220"/></wire>
    <wire><p1 x="320" y="220"/><p2 x="320" y="320"/></wire>
    <wire><p1 x="320" y="320"/><p2 x="320" y="420"/></wire>
    <wire><p1 x="320" y="420"/><p2 x="320" y="480"/></wire>

    <!-- Enable bus (select for muxes) -->
    <wire><p1 x="160" y="540"/><p2 x="280" y="540"/></wire>
    <wire><p1 x="280" y="120"/><p2 x="280" y="220"/></wire>
    <wire><p1 x="280" y="220"/><p2 x="280" y="320"/></wire>
    <wire><p1 x="280" y="320"/><p2 x="280" y="420"/></wire>
    <wire><p1 x="280" y="420"/><p2 x="280" y="540"/></wire>
  </wires>
  <measurementOrdering/>
</circuit>
